{
  "name": "lcta-product-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck:webui": "vue-tsc --noEmit -p frontend/tsconfig.json",
