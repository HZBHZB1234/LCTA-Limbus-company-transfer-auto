    "preview:webui": "vite preview --config frontend/vite.config.ts"
  },
  "dependencies": {
    "pinia": "4.0.2",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "^6.0.3",
    "vite": "8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
